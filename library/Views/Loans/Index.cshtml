cshtml
@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="page-banner">
    <h1>⚔️ Library Loan Records</h1>
    <p>Track borrowed books and their return dates</p>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h3>📚 @Model.Count</h3>
                <p class="mb-0">Total Loan Records</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h3>📖 @Model.Count(x => x.ReturnedOn == null)</h3>
                <p class="mb-0">Books Currently Out</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h3>✅ @Model.Count(x => x.ReturnedOn != null)</h3>
                <p class="mb-0">Books Returned</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📜 Loan History</h2>
    <a asp-action="Borrow" class="btn btn-primary">➕ Borrow a Book</a>
</div>

<div class="card">
    <div class="card-header">
        Active and Previous Loans
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>👤 Member</th>
                        <th>📚 Book</th>
                        <th>📅 Loaned</th>
                        <th>⏰ Due Date</th>
                        <th>⚡ Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td>@loan.MemberName</td>
                            <td><strong>@loan.BookTitle</strong></td>
                            <td>@loan.LoanedOn.ToString("yyyy-MM-dd")</td>
                            <td>@loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @(loan.Status == "Overdue" ? "bg-danger" : loan.Status == "Out" ? "bg-warning text-dark" : "bg-success")">
                                    @(loan.Status == "Overdue" ? "⚠️ " : loan.Status == "Out" ? "📖 " : "✅ ")@loan.Status
                                </span>
                            </td>
                            <td>
                                @if (loan.ReturnedOn == null)
                                {
                                    <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                        <button type="submit" class="btn btn-success btn-sm">↩ Return</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-success">✓ Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>