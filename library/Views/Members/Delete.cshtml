
@model library.Models.Member

@{
    ViewData["Title"] = "Delete a Member";
}

<h1 class="mb-3">Delete a Member</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this member?</p>

    <dl class="row mb-3">
        <dt class="col-4">ID</dt>
        <dd class="col-8">@Model.Member_id</dd>

        <dt class="col-4">Name</dt>
        <dd class="col-8">@Model.Full_Name</dd>

        <dt class="col-4">Email</dt>
        <dd class="col-8">@(Model.Email ?? "—")</dd>

        <dt class="col-4">Member Type</dt>
        <dd class="col-8">@(Model.Member_type ?? "—")</dd>
    </dl>

    <p class="text-muted small">
        This action permanently deletes the member.
    </p>

    <form asp-action="Delete"
          asp-route-id="@Model.Member_id"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
