
@model library.Models.Member

@{
    ViewData["Title"] = "Edit a Member";
}

<h1 class="mb-3">Edit a Member</h1>

<form asp-action="Edit"
      asp-route-id="@Model.Member_id"
      method="post"
      class="card card-body"
      style="max-width:36rem">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Member_id" />

    <div class="mb-3">
        <label class="form-label">Member ID</label>
        <input value="@Model.Member_id" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Full_Name" class="form-label">Name</label>
        <input asp-for="Full_Name" class="form-control" />
        <span asp-validation-for="Full_Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Member_type" class="form-label">Member Type</label>
        <select asp-for="Member_type" class="form-select">
            <option value="">-- Select Member Type --</option>
            <option value="Student">Student</option>
            <option value="Faculty">Faculty</option>
            <option value="Regular">Regular</option>
        </select>
        <span asp-validation-for="Member_type" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
