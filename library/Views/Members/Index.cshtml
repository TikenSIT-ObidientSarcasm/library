@model List<library.Models.Member>

@{
    ViewData["Title"] = "Member";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count members in the catalogue</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a Member</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td class="text-end">@member.Member_id</td>
                <td>@member.Full_Name</td>
                <td>
                    @(member.Email ?? "—")
                </td>
                <td>
                    @(member.Member_type ?? "—")
                </td>
                <td class="text-end">
                    <a asp-action="Edit"
                       asp-route-id="@member.Member_id"
                       class="btn btn-sm btn-outline-secondary">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@member.Member_id"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>