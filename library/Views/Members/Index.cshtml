cshtml
@model List<library.Models.Member>

@{
    ViewData["Title"] = "Member";
}

<div class="page-banner">
    <h1>🛡️ Library Adventurers</h1>
    <p>Manage registered library members</p>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <h3>👥 @Model.Count</h3>
                <p class="mb-0">Registered Members</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <h3>📚 @Model.Sum(x => x.OpenLoans)</h3>
                <p class="mb-0">Books Currently Borrowed</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👤 Member Directory</h2>
    <a asp-action="Create" class="btn btn-primary">➕ Add Member</a>
</div>

<div class="card">
    <div class="card-header">
        📋 Registered Members
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>👤 Full Name</th>
                        <th>📧 Email</th>
                        <th>📱 Member Type</th>
                        <th>📚 Books Out</th>
                        <th>⚙️ Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>@member.MemberId</td>
                            <td><strong>@member.FullName</strong></td>
                            <td>@(member.Email ?? "—")</td>
                            <td>@(member.MemberType ?? "—")</td>
                            <td>
                                <span class="badge @(member.OpenLoans > 0 ? "bg-warning text-dark" : "bg-success")">
                                    📚 @member.OpenLoans
                                </span>
                            </td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@member.MemberId"
                                   class="btn btn-secondary btn-sm">✏️ Edit</a>

                                <a asp-action="Details"
                                   asp-route-id="@member.MemberId"
                                   class="btn btn-info btn-sm">📖 Loans</a>

                                <a asp-action="Delete"
                                   asp-route-id="@member.MemberId"
                                   class="btn btn-danger btn-sm">🗑️ Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>