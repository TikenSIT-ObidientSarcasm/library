
@model library.Models.Member

@{
    ViewData["Title"] = "Add a Member";
}

<h1 class="mb-3">Add a Member</h1>

<form asp-action="Create" method="post"
      class="card card-body" style="max-width:36rem">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Name</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MemberType" class="form-label">Member Type</label>
        <select asp-for="MemberType" class="form-select">
            <option value="">-- Select Member Type --</option>
            <option value="Student">Student</option>
            <option value="Faculty">Faculty</option>
            <option value="Regular">Regular</option>
        </select>
        <span asp-validation-for="MemberType" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
