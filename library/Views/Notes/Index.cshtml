@model List<library.Models.Note>

@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Notes</h1>
        <p class="text-muted mb-0">@Model.Count notes in the catalogue</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a Note</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Title</th>
            <th>Body</th>
            <th>Created On</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td class="text-end">@note.note_id</td>
                <td>@note.title</td>
                <td>
                    @(string.IsNullOrEmpty(note.body) ? "—" : note.body)
                </td>
                <td>
                    @(note.created_on ?? "—")
                </td>
                <td class="text-end">
                    <a asp-action="Edit"
                       asp-route-id="@note.note_id"
                       class="btn btn-sm btn-outline-secondary">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@note.note_id"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>