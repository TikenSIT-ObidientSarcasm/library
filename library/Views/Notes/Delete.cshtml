
@model library.Models.Note

@{
    ViewData["Title"] = "Delete a Note";
}

<h1 class="mb-3">Delete a Note</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this note?</p>

    <dl class="row mb-3">
        <dt class="col-4">Note ID</dt>
        <dd class="col-8">@Model.note_id</dd>

        <dt class="col-4">Title</dt>
        <dd class="col-8">@Model.title</dd>

        <dt class="col-4">Body</dt>
        <dd class="col-8">
            @(string.IsNullOrEmpty(Model.body) ? "—" : Model.body)
        </dd>

        <dt class="col-4">Created On</dt>
        <dd class="col-8">
            @(Model.created_on?.ToString() ?? "—")
        </dd>
    </dl>

    <p class="text-muted small">
        This action permanently deletes the note.
    </p>

    <form asp-controller="Notes"
          asp-action="Delete"
          asp-route-id="@Model.note_id"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
