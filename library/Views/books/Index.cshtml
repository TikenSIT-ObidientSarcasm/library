cshtml
@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="page-banner">
    <h1>📚 The Grand Library</h1>
    <p>Explore the collection of magical books</p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>📖 Book Collection</h2>
        <p class="text-muted mb-0">✨ @Model.Count books available in the catalogue</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">➕ Add a Book</a>
</div>

<div class="card">
    <div class="card-header">
        📜 Library Catalogue
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>📚 Title</th>
                        <th>🏷️ Category</th>
                        <th>💰 Price</th>
                        <th>⚙️ Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>@book.BookId</td>
                            <td><strong>@book.Title</strong></td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @(book.Category ?? "—")
                                </span>
                            </td>
                            <td>₱ @(book.Price?.ToString("N2") ?? "—")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-secondary btn-sm">✏️ Edit</a>
                                <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-danger btn-sm">🗑️ Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>